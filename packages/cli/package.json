{
  "name": "@boolink-dev/cli",
  "version": "0.2.0",
  "description": "Local-first command-line interface for BooLink integrations.",
  "license": "MIT",
  "homepage": "https://boolink.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColinRM000/boolink.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ColinRM000/boolink/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "boolink": "./dist/bin.js",
    "boo": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@boolink-dev/core": "workspace:^",
    "@boolink-dev/registry": "workspace:^",
    "zod": "4.4.3"
  }
}
