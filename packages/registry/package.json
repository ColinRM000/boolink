{
  "name": "@boolink-dev/registry",
  "version": "0.3.0",
  "description": "Machine-readable BooLink registry contracts and discovery helpers.",
  "license": "MIT",
  "homepage": "https://boolink.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColinRM000/boolink.git",
    "directory": "packages/registry"
  },
  "bugs": {
    "url": "https://github.com/ColinRM000/boolink/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog.json": "./src/catalog.json"
  },
  "files": [
    "dist",
    "src/catalog.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@boolink-dev/core": "workspace:^",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@boolink-dev/cloudflare": "workspace:^",
    "@boolink-dev/github": "workspace:^"
  }
}
