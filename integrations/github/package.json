{
  "name": "@boolink-dev/github",
  "version": "0.1.0",
  "description": "Local-first GitHub MCP integration for BooLink.",
  "license": "MIT",
  "homepage": "https://boolink.dev/integrations/github",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColinRM000/boolink.git",
    "directory": "integrations/github"
  },
  "bugs": {
    "url": "https://github.com/ColinRM000/boolink/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": "./dist/server.js"
  },
  "bin": {
    "boolink-github": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@boolink-dev/core": "workspace:^",
    "@boolink-dev/sdk": "workspace:^",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  }
}
